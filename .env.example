# Each pair is [source path pattern, destination URL].
# A :name token in the source captures one path segment. Use the same token in
# the destination to interpolate it. If the destination does not use :suffix,
# a captured :suffix is appended to its path. Rules are checked from top to
# bottom; the first match wins. Copy this file to .env before deploying locally.
# The GitHub Actions production environment also needs a variable with this
# same name and value: SPECIAL_REDIRECT_RULES.
SPECIAL_REDIRECT_RULES='[
  ["/", "https://dy.tsou.me/"],
  ["/cal", "https://dy.tsou.me/cal/"],
  ["/cal/:suffix", "https://people.cs.nycu.edu.tw/~dytsou/cal/"]
]'
