name = "shorten-url"
main = "src/worker.js"
compatibility_date = "2026-01-01"

[[kv_namespaces]]
binding = "LINKS"
id = "your-kv-namespace-id"

[observability]
enabled = true

[observability.logs]
enabled = true
invocation_logs = true
persist = true
head_sampling_rate = 1

[observability.traces]
enabled = true
persist = true
head_sampling_rate = 1
