name = "shorten-url"
main = "src/worker.js"
compatibility_date = "2026-01-01"
# Production must bind this Worker to an Access-protected custom hostname.
# Keep the default workers.dev hostname disabled in the production deployment.
workers_dev = false

[assets]
directory = "./frontend/dist"
binding = "ASSETS"
run_worker_first = true
not_found_handling = "none"

[[kv_namespaces]]
binding = "LINKS"
id = "your-kv-namespace-id"

# Provision a Flagship app, replace the placeholder, and uncomment this block
# before enabling country-targeted shortening. Without it the Worker safely
# keeps the existing shortening behavior.
# [[flagship]]
# binding = "FLAGS"
# app_id = "REPLACE_WITH_FLAGSHIP_APP_ID"

[observability]
enabled = true

[observability.logs]
enabled = true
invocation_logs = true
persist = true
head_sampling_rate = 1

[vars]
# Non-secret Access/Flagship identifiers may be set here or with `wrangler secret`.
# Never put FLAGSHIP_API_TOKEN or FLAGSHIP_CSRF_SECRET in this file.
# FLAGSHIP_APP_ID = "REPLACE_WITH_FLAGSHIP_APP_ID"
# CF_ACCESS_ISSUER = "https://YOURTEAM.cloudflareaccess.com"
# CF_ACCESS_AUDIENCE = "REPLACE_WITH_ACCESS_AUDIENCE"
# ACCESS_ALLOWED_HOSTS = "short.example.com"

[observability.traces]
enabled = true
persist = true
head_sampling_rate = 1
